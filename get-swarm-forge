#!/bin/zsh
set -euo pipefail

valid_agents=(claude codex copilot grok)

# The Kotlin fork, not upstream. Installing from unclebob/swarm-forge would give
# this project the Clojure constitution and the Clojure tool table, and every
# agent would then try to install crap4clj into a Gradle build.
default_repo_url="https://github.com/agrognetti/swarm-forge-kotlin"

usage() {
  echo "usage: get-swarm-forge <branch> [agent] [extra-cli-args...]" >&2
  echo "  branch: two-pack, four-pack, six-pack, or another runnable pack branch" >&2
  echo "  agent: ${valid_agents[*]}" >&2
  echo "  extra-cli-args: appended to each window line after the optional task|batch and forward-only|back-one|back-all fields" >&2
}

if [[ -z "${1:-}" ]]; then
  usage
  exit 1
fi

branch="$1"
shift

agent=""
extra_args=()

if [[ -n "${1:-}" && " ${valid_agents[*]} " == *" $1 "* ]]; then
  agent="$1"
  shift
fi

extra_args=("$@")

repo_url="${SWARMFORGE_REPO_URL:-$default_repo_url}"
base_branch="${SWARMFORGE_BASE_BRANCH:-main}"
tmp_dir="$(mktemp -d)"

cleanup() {
  rm -rf "$tmp_dir"
}
trap cleanup EXIT

download_branch() {
  local ref="$1"
  local dest="$2"
  mkdir -p "$dest"
  curl -fsSL "${repo_url}/archive/refs/heads/${ref}.tar.gz" | tar -xz --strip-components=1 -C "$dest"
}

fail_missing() {
  local missing_path="$1"
  echo "get-swarm-forge: missing required file after composing swarm: $missing_path" >&2
  exit 1
}

base_dir="${SWARMFORGE_BASE_DIR:-$tmp_dir/base}"
pack_dir="${SWARMFORGE_PACK_DIR:-$tmp_dir/pack}"

if [[ -z "${SWARMFORGE_BASE_DIR:-}" ]]; then
  download_branch "$base_branch" "$base_dir"
fi
if [[ -z "${SWARMFORGE_PACK_DIR:-}" ]]; then
  download_branch "$branch" "$pack_dir"
fi

[[ -d "$base_dir/swarmforge/scripts" ]] || fail_missing "swarmforge/scripts from $base_branch"
[[ -d "$base_dir/swarmforge/constitution/articles" ]] || fail_missing "swarmforge/constitution/articles from $base_branch"
[[ -f "$pack_dir/swarm" ]] || fail_missing "swarm from $branch"
[[ -f "$pack_dir/swarmforge/swarmforge.conf" ]] || fail_missing "swarmforge/swarmforge.conf from $branch"
[[ -d "$pack_dir/swarmforge/roles" ]] || fail_missing "swarmforge/roles from $branch"

rm -rf swarmforge .worktrees .swarmforge

mkdir -p swarmforge/constitution/articles
cp -R "$base_dir/swarmforge/scripts" swarmforge/scripts
for shared_article in engineering.prompt workflow.prompt handoffs.prompt; do
  [[ -f "$base_dir/swarmforge/constitution/articles/$shared_article" ]] \
    && cp "$base_dir/swarmforge/constitution/articles/$shared_article" \
         "swarmforge/constitution/articles/$shared_article"
done

# `swarm` treats swarmforge/scripts/shared-articles as the marker that says the
# scripts directory is already populated, and when the marker is absent it deletes
# swarmforge/scripts and re-downloads it from its own default archive. That default
# is upstream, so without this marker the very first ./swarm run replaces this
# fork's Kotlin tools with upstream's Clojure ones, leaving a project whose
# constitution names mutate4kotlin and whose swarm_tool.sh has never heard of it.
# Write the marker exactly as swarm would, so the self-heal never fires here.
mkdir -p swarmforge/scripts/shared-articles
cp -R "$base_dir/swarmforge/constitution/articles/." swarmforge/scripts/shared-articles/

# The list of untracked build inputs the launcher copies into each worktree.
# Installed rather than left to the operator because `rm -rf swarmforge` above
# removes it on every re-install: like the constitution articles, it is
# customized in the fork, not in the installed copy. The launcher falls back to a
# built-in default list when this file is absent.
[[ -f "$base_dir/swarmforge/worktree-files.txt" ]] \
  && cp "$base_dir/swarmforge/worktree-files.txt" swarmforge/worktree-files.txt

cp "$pack_dir/swarm" swarm
cp "$pack_dir/swarmforge/swarmforge.conf" swarmforge/swarmforge.conf
[[ -f "$pack_dir/swarmforge/constitution.prompt" ]] \
  && cp "$pack_dir/swarmforge/constitution.prompt" swarmforge/constitution.prompt
cp -R "$pack_dir/swarmforge/roles" swarmforge/roles
if [[ -d "$pack_dir/swarmforge/constitution/articles" ]]; then
  for pack_article in "$pack_dir/swarmforge/constitution/articles"/*; do
    [[ -f "$pack_article" ]] || continue
    article_name="${pack_article:t}"
    case "$article_name" in
      engineering.prompt|workflow.prompt|handoffs.prompt) continue ;;
    esac
    cp "$pack_article" "swarmforge/constitution/articles/$article_name"
  done
fi

required_files=(
  swarm
  swarmforge/swarmforge.conf
  swarmforge/constitution.prompt
  swarmforge/constitution/articles/handoffs.prompt
  swarmforge/constitution/articles/workflow.prompt
  swarmforge/constitution/articles/engineering.prompt
  swarmforge/scripts/swarmforge.sh
  swarmforge/scripts/handoffd.bb
  swarmforge/scripts/done_with_current.sh
)

for required_path in "${required_files[@]}"; do
  [[ -e "$required_path" ]] || fail_missing "$required_path"
done

while IFS= read -r role; do
  [[ -f "swarmforge/roles/${role}.prompt" ]] || fail_missing "swarmforge/roles/${role}.prompt"
done < <(awk '/^window/ { print $2 }' swarmforge/swarmforge.conf)

chmod +x swarm

if [[ ( -n "$agent" || ${#extra_args[@]} -gt 0 ) && -f swarmforge/swarmforge.conf ]]; then
  extra_args_str="${(j: :)extra_args}"
  awk -v agent="$agent" -v extra_args="$extra_args_str" '
    /^window/ {
      line = $1
      for (i = 2; i <= NF; i++) {
        field = $i
        if (i == 3 && agent != "") field = agent
        # --yolo is codex and copilot syntax, and the packs ship it because their
        # default agent is codex. Swapping the agent has to drop it: claude exits
        # with "unknown option --yolo" before it ever reads its prompt, so every
        # window would die at startup. The launcher adds the right permission flag
        # per agent by itself (--yolo for codex, --permission-mode
        # bypassPermissions for claude), so removing it here loses nothing.
        if (agent != "" && field == "--yolo") continue
        line = line " " field
      }
      if (extra_args != "") line = line " " extra_args
      print line
      next
    }
    { print }
  ' swarmforge/swarmforge.conf > swarmforge/swarmforge.conf.tmp \
    && mv swarmforge/swarmforge.conf.tmp swarmforge/swarmforge.conf
fi

echo "SwarmForge ${branch} installed. Run ./swarm to start."
